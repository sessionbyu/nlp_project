# ==============================================
# NLP 项目环境变量配置示例
# 复制此文件为 .env 并修改配置值
# ==============================================

# Redis 配置
REDIS_PASSWORD=your_redis_password_here

# 端口配置
BACKEND_PORT=8000
FRONTEND_PORT=8501
VUE_FRONTEND_PORT=3000

# Nginx 配置
NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443  # 生产环境启用 HTTPS

# 时区
TZ=Asia/Shanghai

# CORS 配置：允许的前端源（逗号分隔）
# 注意：当 allow_credentials=True 时，不能使用 ["*"]
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://your-ip:3000,http://your-ip:5173,https://your-domain.com

# PostgreSQL 数据库配置
POSTGRES_USER=nlp_user
POSTGRES_PASSWORD=nlp_pass
POSTGRES_DB=nlp_db

# ==============================================
# 其他可选配置
# ==============================================

# 模型配置
# MODEL_PATH=/data/models/bert-base-chinese
# USE_CACHE=true

# 日志配置
# LOG_LEVEL=INFO
# LOG_DIR=/app/logs/backend

# 限流配置
# RATE_LIMIT_ENABLED=false
